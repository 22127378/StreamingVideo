#!/usr/bin/env bash
# Chặn commit còn sót conflict marker hoặc lệnh debugger trong các file đã stage.

status=0
while IFS= read -r file; do
  [[ -f "$file" ]] || continue
  case "$file" in *.lock|*package-lock.json) continue ;; esac

  if git diff --cached -U0 -- "$file" | grep -qE '^\+(<<<<<<<|>>>>>>>)( |$)'; then
    echo "pre-commit: còn conflict marker trong $file" >&2
    status=1
  fi
  if [[ "$file" =~ \.(js|mjs|cjs|ts)$ ]] && git diff --cached -U0 -- "$file" | grep -qE '^\+.*\bdebugger;'; then
    echo "pre-commit: còn 'debugger;' trong $file" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

exit $status
