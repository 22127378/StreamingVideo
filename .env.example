# ========================================================
# StreamForge Environment Configuration (Local & Cloud)
# ========================================================

# General Configuration
PORT=4000
NODE_ENV=development

# AWS Configuration (LocalStack default: us-east-1)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Endpoint (Set to empty string when deploying to real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true

# S3 Storage Configuration
S3_RAW_UPLOADS_BUCKET=streamforge-raw-uploads
S3_PROCESSED_BUCKET=streamforge-processed

# SQS Queue Configuration
SQS_TRANSCODE_QUEUE_URL=http://localhost:4566/000000000000/streamforge-transcode-queue
SQS_TRANSCODE_DLQ_URL=http://localhost:4566/000000000000/streamforge-transcode-dlq

# DynamoDB Configuration
DYNAMODB_VIDEOS_TABLE=streamforge-videos

# CDN / Local Streaming Base URL
# In local dev, we serve processed files directly from S3/LocalStack or API proxy
CDN_BASE_URL=http://localhost:4566/streamforge-processed

# Security / Token Secret (For local tier-gating simulation)
JWT_SECRET=streamforge-super-secret-key-2026
