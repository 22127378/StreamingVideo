# ========================================================
# StreamForge Environment Configuration (Local & Cloud)
# ========================================================

# General Configuration
PORT=4000
NODE_ENV=development

# AWS Configuration (LocalStack default: us-east-1)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Endpoint (Set to empty string when deploying to real AWS)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true

# S3 Storage Configuration
S3_RAW_UPLOADS_BUCKET=streamforge-raw-uploads
S3_PROCESSED_BUCKET=streamforge-processed

# SQS Queue Configuration
SQS_TRANSCODE_QUEUE_URL=http://localhost:4566/000000000000/streamforge-transcode-queue
SQS_TRANSCODE_DLQ_URL=http://localhost:4566/000000000000/streamforge-transcode-dlq

# PostgreSQL (container postgres trong docker-compose). Trên AWS: Aurora với IAM auth (DB_IAM_AUTH=true, DB_SSL=true)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=streamforge
DB_SSL=false
# migrate.js tạo user streamforge_api và streamforge_worker với mật khẩu DB_PASSWORD.
# Worker chạy bằng npm cũng đọc file này; chạy với DB_USER=streamforge_worker để có đúng quyền của worker.
DB_USER=streamforge_api
DB_PASSWORD=streamforge
# Chỉ migrate.js dùng
DB_MASTER_USER=streamforge
DB_MASTER_PASSWORD=streamforge

# CDN / Local Streaming Base URL
# In local dev, we serve processed files directly from S3/LocalStack or API proxy
CDN_BASE_URL=http://localhost:4566/streamforge-processed

# Playback token secret. Local only; with NODE_ENV=production the API refuses
# to start unless this is set to a random value of at least 32 characters.
JWT_SECRET=streamforge-local-dev-secret
